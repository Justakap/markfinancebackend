# Local MongoDB
# MONGO_URI=mongodb://127.0.0.1:27017/markfinance

# MongoDB Atlas (replace user, password, cluster)
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/markfinance?retryWrites=true&w=majority

MONGO_URI=mongodb://127.0.0.1:27017/markfinance
JWT_SECRET=your_secure_random_secret_here
PORT=5001
NODE_ENV=development

# --- Upstox ---
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here
UPSTOX_INSTRUMENT_MASTER_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz

# --- CORS (production) ---
# Comma-separated list of allowed browser origins for the API + Socket.IO.
# Defaults to https://markfinance.netlify.app (+ localhost:3000/3001 when NODE_ENV != production)
# if left unset — see config/cors.js. Set explicitly in Render if the frontend
# origin ever changes.
# ALLOWED_ORIGINS=https://markfinance.netlify.app
# FRONTEND_URL=https://markfinance.netlify.app

# --- Debug/validation routes (disabled in production unless explicitly enabled) ---
# ENABLE_VALIDATION_MODE=true

# --- Upstox request queue / retry tuning (all optional, sane defaults in code) ---
# UPSTOX_REQUEST_GAP_MS=50
# UPSTOX_MAX_RETRIES=3
# UPSTOX_RETRY_BASE_MS=500
# UPSTOX_RETRY_MAX_MS=8000
# UPSTOX_LTP_POLL_MS=2000
# UPSTOX_WS_RECONNECT_MS=5000
# UPSTOX_INDICATOR_REFRESH_MS=15000
# UPSTOX_FEED_MODE=ltpc
# UPSTOX_FUTURES_FEED_MODE=full_d5
# UPSTOX_OPTION_FEED_MODE=option_greeks

# --- Cache sizing (all optional, sane defaults in code) ---
# UPSTOX_PE_TTL_MS=86400000
# UPSTOX_PE_CACHE_MAX_SIZE=2000
# UPSTOX_SEARCH_CACHE_MAX_SIZE=500
# UPSTOX_INVALID_KEY_CACHE_MAX_SIZE=5000
# UPSTOX_LIVE_DATA_MAX_SIZE=3000
# INDICATOR_BUNDLE_MAX_AGE_MS=

# --- Backtest engine tuning (optional) ---
# BACKTEST_COMMISSION_PCT=
# BACKTEST_SLIPPAGE_PCT=
